ENVIRONMENT="production"

# Schedule settings
SCHEDULE_SEMESTER_START="01.09.2027"
SCHEDULE_SEMESTER_END="30.01.2028"
SCHEDULE_WEEK_START="1"
SCHEDULE_WEEK_COUNT="2"

# Cache settings for the API routes
CACHE_NAME="schedule-connect-groupoid"
CACHE_CTRL="public, max-age=43200, stale-while-revalidate=86400"

# API key for client authentication
SERVICE_API_KEY="your_api_key_here"
